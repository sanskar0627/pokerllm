# ─── LLM API Keys — NOT NEEDED ───────────────────────────────────────────────
# PokerLLM is strictly BYOK (bring-your-own-key): every player connects their
# own provider keys in the AI Players cards, and games only ever run on the
# keys THEY saved (AES-256-GCM encrypted, scoped to their account).
# The server needs NO provider API keys. Do not put any here.

# ─── Database (Neon Postgres via Prisma) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Authentication (NextAuth) ───────────────────────────────────────────────
AUTH_SECRET=           # Generate with: openssl rand -base64 32
AUTH_GOOGLE_ID=        # Google OAuth client ID (optional, for Google login)
AUTH_GOOGLE_SECRET=    # Google OAuth client secret

# ─── Email (for verification emails) ─────────────────────────────────────────
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# ─── Redis (game state persistence) ──────────────────────────────────────────
# Include password in the URL. Default dev password is pokerllm_dev_redis_2024.
# In production, set REDIS_PASSWORD env var and use a strong password.
REDIS_PASSWORD=pokerllm_dev_redis_2024
REDIS_URL=redis://:pokerllm_dev_redis_2024@localhost:6379

# ─── Production Settings ─────────────────────────────────────────────────────
# REQUIRED in production — comma-separated allowed origins for Socket.io CORS.
# Example: https://pokerllm.com,https://www.pokerllm.com
# Server will refuse to start in production if this is not set.
ALLOWED_ORIGIN=

# Secret for protecting the cron cleanup endpoint (required in all environments).
CRON_SECRET=

# ─── BYOK API-key vault (REQUIRED — encrypts users' AI keys) ─────────────────
# 32 bytes base64 — encrypts user-provided AI API keys at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
# Dev fallback derives from AUTH_SECRET; ALWAYS set this in production.
AI_KEY_ENCRYPTION_SECRET=
