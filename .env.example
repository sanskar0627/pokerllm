# ─── LLM API Keys — NOT NEEDED ───────────────────────────────────────────────
# PokerLLM is strictly BYOK (bring-your-own-key): every player connects their
# own provider keys in the AI Players cards, and games only ever run on the
# keys THEY saved (AES-256-GCM encrypted, scoped to their account).
# The server needs NO provider API keys. Do not put any here.

# ─── Database (Neon Postgres via Prisma) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Authentication (NextAuth) ───────────────────────────────────────────────
AUTH_SECRET=            # Generate with: openssl rand -base64 32
GOOGLE_CLIENT_ID=       # Google OAuth client ID (optional, for Google login)
GOOGLE_CLIENT_SECRET=   # Google OAuth client secret

# ─── Email (verification emails) ─────────────────────────────────────────────
# Transport priority: Resend → Brevo → Gmail SMTP (first configured wins).
#
# PRODUCTION (recommended): Resend HTTPS API. Free tier: 100 mails/day.
# 1. resend.com → Domains → add + verify your domain (DNS records)
# 2. API Keys → create → paste below
# 3. EMAIL_SENDER must be an address on the verified domain
RESEND_API_KEY=        # re_...
EMAIL_SENDER=          # e.g. noreply@sanskarshukla.com

# Alternative: Brevo HTTPS API (free tier: 300 mails/day, needs account activation).
BREVO_API_KEY=

# LOCAL fallback (used only when RESEND/BREVO keys are unset): Gmail SMTP.
# GMAIL_APP_PASSWORD is a 16-char App Password (Google Account → Security →
# 2-Step Verification → App passwords), NOT your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=            # e.g. PokerLLM <you@gmail.com>

# ─── Public URL (REQUIRED in production) ─────────────────────────────────────
# Used in verification email links and by NextAuth. Your deployed https URL.
NEXTAUTH_URL=

# ─── Redis (game state persistence) ──────────────────────────────────────────
# Generate a strong password: openssl rand -hex 24
# Under docker compose, REDIS_URL is set automatically from REDIS_PASSWORD —
# only set REDIS_URL manually for local dev outside compose.
REDIS_PASSWORD=
REDIS_URL=              # local dev only, e.g. redis://:<password>@localhost:6379

# ─── Shared Postgres in docker-compose (n8n/exness — NOT poker) ──────────────
# Poker's DB is Neon (DATABASE_URL above). This guards the shared container.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ─── Reverse proxy ───────────────────────────────────────────────────────────
# Set to 1 when behind Caddy/nginx so rate limiting sees real client IPs.
# (docker-compose sets this automatically; Railway is auto-detected.)
TRUSTED_PROXY=

# ─── Production Settings ─────────────────────────────────────────────────────
# REQUIRED in production — comma-separated allowed origins for Socket.io CORS.
# Example: https://pokerllm.com,https://www.pokerllm.com
# Server will refuse to start in production if this is not set.
ALLOWED_ORIGIN=

# Secret for protecting the cron cleanup endpoint (required in all environments).
CRON_SECRET=

# ─── BYOK API-key vault (REQUIRED — encrypts users' AI keys) ─────────────────
# 32 bytes base64 — encrypts user-provided AI API keys at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
# Dev fallback derives from AUTH_SECRET; ALWAYS set this in production.
AI_KEY_ENCRYPTION_SECRET=
